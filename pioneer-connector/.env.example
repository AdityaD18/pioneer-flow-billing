# Pioneer Connector Configuration
APP_NAME="Pioneer Tally Connector"
APP_ENV=development
API_PREFIX=/api/v1

# Tally Server Defaults
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_TIMEOUT=30
TALLY_COMPANY="Pioneer Automation"

# Cache & Sync Defaults
CACHE_TTL_SECONDS=300
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
