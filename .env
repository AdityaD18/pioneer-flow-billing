# Application Metadata
APP_NAME=Pioneer Flow Billing ERP
APP_VERSION=2.0.0
APP_ENV=production

# Data Provider Configuration (Supported: tally | Fallback: excel)
DATA_PROVIDER=tally

# Microservice Connector API Endpoint
CONNECTOR_API_URL=http://localhost:8000/api/v1

# Database & File Storage Paths
DATABASE_PATH=instance/db/database.db
EXPORTS_DIR=exports
UPLOADS_DIR=uploads
LOGS_DIR=logs

# Reference Source Spreadsheet Files (Legacy Import Support)
STOCK_EXCEL_PATH=group order status.xlsx
COST_EXCEL_PATH=cost_data.xlsx

# Business & Company Defaults
COMPANY_NAME=PIONEER AUTOMATION
COMPANY_SUBTITLE=Mechanical & Industrial Billing Solutions
COMPANY_FOOTER=Thank you for your business! | Pioneer Automation Corp
DEFAULT_GST_RATE=18.0
DEFAULT_PAYMENT_TERMS=Net 30 Days
DEFAULT_MAKE=WAGO
DEFAULT_UNIT=PCS
